#!/usr/bin/env sh
# Сообщение коммита: первая строка — в imperative mood, до 72 символов.
# Примеры: «Добавить страницу каталога», «Исправить фильтр по цене».

if [ -z "$1" ]; then
  echo "❌ Пустое сообщение коммита не допускается."
  exit 1
fi

subject=$(head -n 1 "$1")

if [ "${#subject}" -gt 72 ]; then
  echo "❌ Первая строка сообщения длиннее 72 символов (${#subject})."
  exit 1
fi

case "$subject" in
  *: |*!)
    echo "❌ Сообщение коммита не должно заканчиваться двоеточием или восклицательным знаком."
    exit 1
    ;;
esac

exit 0
