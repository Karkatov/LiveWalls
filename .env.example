# ─────────────────────────────────────────────────────────────
# LiveWalls Site — переменные окружения
# Скопируйте в .env.local и заполните. .env.local в .gitignore!
# ─────────────────────────────────────────────────────────────

# --- Общие ---
# Сайт работает на моках. Поставьте false, когда подключите реальный API.
NEXT_PUBLIC_USE_MOCK_DATA=true

# Базовый URL API (TODO: подключить бэкенд LiveWalls)
NEXT_PUBLIC_API_BASE_URL=

# Хостинг файлов (Timeweb S3) и CDN (TODO: подключить)
NEXT_PUBLIC_S3_BASE_URL=
NEXT_PUBLIC_CDN_BASE_URL=

# Платёжный провайдер: none | lava | robokassa
NEXT_PUBLIC_PAYMENT_PROVIDER=none

# --- Секреты (НЕ публичные, только сервер) ---
# Пароль админки /admin
ADMIN_PASSWORD=livewalls-admin

# Ключи платёжных систем (TODO: получить у LAVA / Robokassa)
LAVA_SHOP_ID=
LAVA_SECRET_KEY=
ROBOKASSA_LOGIN=
ROBOKASSA_PASSWORD_1=

# --- Аналитика (TODO: включить) ---
NEXT_PUBLIC_YM_ID=
NEXT_PUBLIC_GA_ID=

# --- Сборка / деплой ---
# default | standalone | export
NEXT_OUTPUT=default
# Для GitHub Pages: /<имя-репозитория>
NEXT_BASE_PATH=
NEXT_ASSET_PREFIX=

# Секрет для подписи сессий (админка/кабинет)
AUTH_SECRET=change-me-to-a-long-random-string
